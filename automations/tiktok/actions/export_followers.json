{
  "$schema": "../../../data/schemas/action.v1.schema.json",
  "actionType": "export_followers",
  "platform": "TIKTOK",
  "version": "1.2.0",
  "description": "Fetch the followers (sourceType FOLLOWERS_FETCH) or following (FOLLOWING_FETCH) list of a TikTok profile: username, profile URL, display name and follow state (the viewer's relationship button: Follow back, Following, Friends, …) per account. If you and the account both have TikTok's profile view history on, it shows them that you viewed their profile.",
  "sideEffects": "read",
  "visibility": [
    "profile_view_visible_to_owner"
  ],
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": true,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "profileUrl",
        "type": "string",
        "description": "Profile URL or @username whose followers (or following) list to export",
        "aliases": [
          "targets",
          "selectedListItems",
          "target_url",
          "targetUsername"
        ],
        "ui": {
          "label": "Profile",
          "placeholder": "https://www.tiktok.com/@nasa"
        }
      }
    ],
    "optional": [
      {
        "name": "sourceType",
        "type": "select",
        "default": "FOLLOWERS_FETCH",
        "options": [
          "FOLLOWERS_FETCH",
          "FOLLOWING_FETCH"
        ],
        "description": "Which list to export"
      },
      {
        "name": "maxResultsCount",
        "type": "number",
        "default": 50,
        "min": 1,
        "max": 1000,
        "description": "Maximum accounts to export"
      }
    ]
  },
  "outputs": {
    "success": [
      "username",
      "url",
      "displayName",
      "followState",
      "source",
      "profileUrl"
    ],
    "failure": []
  },
  "steps": [
    {
      "id": "list_accounts",
      "type": "call_bot_method",
      "methodName": "list_followers",
      "args": [
        "{{profileUrl}}",
        "{{sourceType or 'FOLLOWERS_FETCH'}}",
        "{{maxResultsCount or 50}}"
      ],
      "variable_name": "accounts",
      "timeout": 300,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "save_accounts",
      "type": "save_data",
      "dataSource": "accounts"
    }
  ],
  "errorHandling": {
    "globalRetries": 0,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
