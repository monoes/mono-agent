{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "auto_reply_dms",
  "platform": "TIKTOK",
  "version": "1.1.0",
  "description": "Reply to unread conversations in the TikTok inbox with replyText. Conversations are matched by their exact name (a name shared by several conversations fails); each reply is verified in the chat whose header carries that name.",
  "sideEffects": "message",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": true,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      "startDate",
      "endDate",
      "pollInterval"
    ],
    "optional": [
      "selectedListItems",
      "replyText",
      "maxReplies"
    ]
  },
  "outputs": {
    "success": [
      "name",
      "lastMessage",
      "time",
      "unread",
      "success",
      "status",
      "verified",
      "recipient",
      "nickname",
      "conversation"
    ],
    "failure": [
      "failedItems"
    ]
  },
  "steps": [
    {
      "id": "list_unread_conversations",
      "type": "call_bot_method",
      "methodName": "list_conversations",
      "args": [
        "{{maxReplies or 20}}",
        "true"
      ],
      "variable_name": "conversations",
      "timeout": 60,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "reply",
      "sideEffect": true,
      "type": "call_bot_method",
      "methodName": "reply_to_conversation",
      "args": [
        "{{item.name}}",
        "{{replyText}}"
      ],
      "variable_name": "replyResult",
      "timeout": 90,
      "onError": {
        "action": "mark_failed"
      },
      "onSuccess": {
        "action": "update_progress",
        "increment": "itemsCount"
      }
    },
    {
      "id": "wait_between_replies",
      "type": "wait",
      "duration": "{{delayBetweenReplies or 5}}",
      "waitFor": "time"
    }
  ],
  "loops": [
    {
      "id": "process_conversations",
      "iterator": "conversations",
      "indexVar": "reachedIndex",
      "steps": [
        "reply",
        "wait_between_replies"
      ],
      "onComplete": "update_action_state"
    }
  ],
  "errorHandling": {
    "globalRetries": 0,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
