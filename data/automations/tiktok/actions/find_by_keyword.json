{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "find_by_keyword",
  "platform": "TIKTOK",
  "version": "1.1.0",
  "description": "Search TikTok videos by keyword and return up to maxResultsCount results (url, id, author, description, thumbnail). A search that renders no result cards fails rather than returning nothing. The search may be kept in your TikTok search history.",
  "sideEffects": "read",
  "visibility": ["search_may_be_saved"],
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": true,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      "keyword"
    ],
    "optional": [
      { "name": "maxResultsCount", "type": "number", "default": 20, "description": "Maximum number of videos" }
    ]
  },
  "outputs": {
    "success": [
      "url",
      "id",
      "author",
      "author_name",
      "description",
      "thumbnail",
      "keyword"
    ],
    "failure": []
  },
  "steps": [
    {
      "id": "search_videos",
      "type": "call_bot_method",
      "methodName": "search_videos",
      "args": [
        "{{keyword}}",
        "{{maxResultsCount or 20}}"
      ],
      "variable_name": "videos",
      "timeout": 180,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "save_videos",
      "type": "save_data",
      "dataSource": "videos"
    }
  ],
  "errorHandling": {
    "globalRetries": 0,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
