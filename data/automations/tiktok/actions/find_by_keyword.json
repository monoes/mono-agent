{
  "actionType": "find_by_keyword",
  "platform": "TIKTOK",
  "version": "1.1.0",
  "description": "Search TikTok videos by keyword and return up to maxResultsCount results (url, id, author, description, thumbnail). A search that renders no result cards fails rather than returning nothing.",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": true,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      "keyword",
      "maxResultsCount"
    ],
    "optional": []
  },
  "outputs": {
    "success": [
      "resultsCount",
      "maxResultsCount"
    ],
    "failure": []
  },
  "steps": [
    {
      "id": "search_videos",
      "type": "call_bot_method",
      "methodName": "search_videos",
      "args": [
        "{{keyword}}",
        "{{maxResultsCount or 20}}"
      ],
      "variable_name": "videos",
      "timeout": 180,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "save_videos",
      "type": "save_data",
      "dataSource": "videos"
    }
  ],
  "errorHandling": {
    "globalRetries": 0,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
