{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "send_dms",
  "platform": "TIKTOK",
  "version": "1.1.0",
  "description": "Send direct messages to a list of recipients on TikTok. Each recipient's chat is opened from their profile's Message button; a message counts as sent only when it renders in the chat whose header names that recipient (or the composer is cleared by the send). Recipients without a Message button fail — no other button is clicked instead. If you and the account both have TikTok's profile view history on, it shows them that you viewed their profile.",
  "sideEffects": "message",
  "visibility": ["profile_view_visible_to_owner"],
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      "selectedListItems",
      "messageText"
    ],
    "optional": [
      "messageSubject"
    ]
  },
  "outputs": {
    "success": [
      "success",
      "status",
      "verified",
      "recipient",
      "nickname",
      "profileURL",
      "username"
    ],
    "failure": [
      "failedMessages"
    ]
  },
  "steps": [
    {
      "id": "send_dm",
      "sideEffect": true,
      "type": "call_bot_method",
      "methodName": "send_dm",
      "args": [
        "{{item.url or item.href or item.username or item}}",
        "{{messageText}}"
      ],
      "variable_name": "dmResult",
      "timeout": 90,
      "onError": {
        "action": "mark_failed"
      },
      "onSuccess": {
        "action": "update_progress",
        "increment": "recipientsCount"
      }
    },
    {
      "id": "wait_between_messages",
      "type": "wait",
      "duration": "{{delayBetweenMessages or 5}}",
      "waitFor": "time"
    }
  ],
  "loops": [
    {
      "id": "process_recipients",
      "iterator": "selectedListItems",
      "indexVar": "reachedIndex",
      "steps": [
        "send_dm",
        "wait_between_messages"
      ],
      "onComplete": "update_action_state"
    }
  ],
  "errorHandling": {
    "globalRetries": 0,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
