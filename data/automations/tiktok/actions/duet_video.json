{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "duet_video",
  "platform": "TIKTOK",
  "version": "1.0.0",
  "description": "Open TikTok's duet creator for videos (nothing is recorded or published; finishing the duet needs a person). Opening a video page may count as a view.",
  "sideEffects": "write",
  "visibility": ["video_view_counted"],
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "selectedListItems",
        "type": "list",
        "description": "Video URLs to open duet creator for"
      }
    ],
    "optional": [
      {
        "name": "delayBetweenVideos",
        "type": "number",
        "default": 5,
        "min": 2,
        "max": 60,
        "description": "Seconds to wait between videos"
      }
    ]
  },
  "outputs": {
    "success": [
      "success",
      "status",
      "published",
      "videoURL"
    ],
    "failure": [
      "failedItems"
    ]
  },
  "steps": [
    {
      "id": "t1_duet_video",
      "type": "call_bot_method",
      "sideEffect": true,
      "methodName": "duet_video",
      "args": [
        "{{item.url or item}}"
      ],
      "variable_name": "duetResult",
      "timeout": 60,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "wait",
      "type": "wait",
      "duration": "{{delayBetweenVideos or 5}}",
      "waitFor": "time"
    },
    {
      "id": "log_success",
      "type": "log",
      "value": "Duet opened for: {{item.url or item}}"
    }
  ],
  "loops": [
    {
      "id": "process_videos",
      "iterator": "selectedListItems",
      "indexVar": "reachedIndex",
      "steps": [
        "t1_duet_video",
        "wait",
        "log_success"
      ],
      "onComplete": "update_action_state"
    }
  ],
  "errorHandling": {
    "globalRetries": 1,
    "retryDelay": 5000,
    "onFinalFailure": "log_and_continue"
  }
}
