{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "export_followers",
  "platform": "TIKTOK",
  "version": "1.1.0",
  "description": "Fetch the followers (sourceType FOLLOWERS_FETCH) or following (FOLLOWING_FETCH) list of a TikTok profile: username, profile URL, display name and follow state (the viewer's relationship button: Follow back, Following, Friends, …) per account",
  "sideEffects": "read",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": true,
    "supportsRetry": true
  },
  "inputs": {
    "optional": [
      "sourceType",
      "maxResultsCount",
      "listId",
      "profileUrl"
    ]
  },
  "outputs": {
    "success": [
      "resultsCount",
      "maxResultsCount"
    ],
    "failure": []
  },
  "steps": [
    {
      "id": "list_accounts",
      "type": "call_bot_method",
      "methodName": "list_followers",
      "args": [
        "{{profileUrl or selectedListItems[0].url or selectedListItems[0]}}",
        "{{sourceType}}",
        "{{maxResultsCount or 50}}"
      ],
      "variable_name": "accounts",
      "timeout": 300,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "save_accounts",
      "type": "save_data",
      "dataSource": "accounts"
    }
  ],
  "errorHandling": {
    "globalRetries": 0,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
