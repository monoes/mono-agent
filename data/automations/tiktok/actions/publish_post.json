{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "publish_post",
  "platform": "TIKTOK",
  "version": "1.1.0",
  "description": "Publish a video to TikTok through TikTok Studio: attach the media, replace the prefilled caption with text, wait for processing, post, and confirm TikTok accepted it (success banner or redirect to the content manager)",
  "sideEffects": "write",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      "text",
      "media"
    ],
    "optional": [
      "locationTag",
      "selectedListItems"
    ]
  },
  "outputs": {
    "success": ["success", "status", "verified"],
    "failure": []
  },
  "steps": [
    {
      "id": "navigate_to_upload",
      "type": "navigate",
      "url": "https://www.tiktok.com/tiktokstudio/upload?from=webapp",
      "waitFor": "page_load",
      "timeout": 30,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "find_file_input",
      "type": "find_element",
      "selector": "input[type='file'][accept*='video']",
      "alternatives": [
        "input[type='file']"
      ],
      "timeout": 20,
      "onError": {
        "action": "mark_failed"
      },
      "intent": "the video file input of the TikTok Studio upload form"
    },
    {
      "id": "upload_media",
      "type": "upload",
      "elementRef": "find_file_input",
      "text": "{{media}}",
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "caption_and_post",
      "sideEffect": true,
      "type": "call_bot_method",
      "methodName": "publish_uploaded_video",
      "args": [
        "{{text}}"
      ],
      "variable_name": "publishResult",
      "timeout": 300,
      "onError": {
        "action": "mark_failed"
      }
    }
  ],
  "errorHandling": {
    "globalRetries": 0,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
