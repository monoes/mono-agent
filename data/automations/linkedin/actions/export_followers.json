{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "export_followers",
  "platform": "LINKEDIN",
  "version": "2.0.0",
  "description": "List the signed-in member's LinkedIn followers, or the people they follow",
  "sideEffects": "read",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": true,
    "supportsRetry": true
  },
  "inputs": {
    "optional": [
      {
        "name": "sourceType",
        "type": "select",
        "options": [
          "FOLLOWERS_FETCH",
          "FOLLOWING_FETCH"
        ],
        "description": "Followers or following (LinkedIn only shows these for your own account)",
        "default": "FOLLOWERS_FETCH"
      },
      {
        "name": "maxResultsCount",
        "type": "number",
        "default": 50,
        "min": 1,
        "max": 1000
      }
    ]
  },
  "outputs": {
    "success": [
      "url",
      "profile_url",
      "username",
      "full_name",
      "headline",
      "job_title",
      "location",
      "connection_degree",
      "you_follow"
    ],
    "failure": [
      "failedItems"
    ]
  },
  "steps": [
    {
      "id": "list_people",
      "type": "call_bot_method",
      "methodName": "list_followers",
      "args": [
        "{{sourceType}}",
        "{{maxResultsCount or 50}}"
      ],
      "variable_name": "people",
      "timeout": 600,
      "onError": {
        "action": "mark_failed"
      }
    }
  ]
}
