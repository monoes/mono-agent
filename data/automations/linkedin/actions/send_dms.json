{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "send_dms",
  "platform": "LINKEDIN",
  "version": "2.0.0",
  "description": "Send direct messages to a list of LinkedIn members (only through their Message option — never a connection request). Visiting a profile shows you in that member's \"Who viewed your profile\"; LinkedIn only hides this when you switch to private mode in LinkedIn's settings (Visibility > Profile viewing options).",
  "sideEffects": "message",
  "visibility": ["profile_view_visible_to_owner"],
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "selectedListItems",
        "type": "list",
        "description": "Profile URLs, usernames or messaging thread URLs"
      },
      {
        "name": "messageText",
        "type": "string",
        "description": "Message to send"
      }
    ],
    "optional": [
      {
        "name": "delayBetweenMessages",
        "type": "number",
        "default": 10,
        "min": 1,
        "max": 600
      }
    ]
  },
  "outputs": {
    "success": [
      "recipientsCount",
      "reachedIndex"
    ],
    "failure": [
      "failedItems"
    ]
  },
  "steps": [
    {
      "id": "send_message",
      "sideEffect": true,
      "type": "call_bot_method",
      "methodName": "send_message",
      "args": [
        "{{item.url or item.href or item.username or item}}",
        "{{messageText}}"
      ],
      "variable_name": "sendResult",
      "timeout": 120,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "wait",
      "type": "wait",
      "duration": "{{delayBetweenMessages or 10}}",
      "waitFor": "time"
    },
    {
      "id": "log",
      "type": "log",
      "value": "Messaged: {{item.url or item}}"
    }
  ],
  "loops": [
    {
      "id": "process_recipients",
      "iterator": "selectedListItems",
      "indexVar": "reachedIndex",
      "steps": [
        "send_message",
        "wait",
        "log"
      ]
    }
  ]
}
