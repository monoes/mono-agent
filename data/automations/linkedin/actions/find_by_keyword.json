{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "find_by_keyword",
  "platform": "LINKEDIN",
  "version": "2.0.0",
  "description": "Find LinkedIn members by keyword (people search). The search may be kept in your LinkedIn recent searches and counts toward the listed members' search appearances.",
  "sideEffects": "read",
  "visibility": ["search_may_be_saved"],
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": true,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "keyword",
        "type": "string",
        "description": "Search keywords, or a linkedin.com/search/results/people URL"
      },
      {
        "name": "maxResultsCount",
        "type": "number",
        "description": "Maximum number of people"
      }
    ],
    "optional": []
  },
  "outputs": {
    "success": [
      "resultsCount",
      "maxResultsCount"
    ],
    "failure": [
      "failedItems"
    ]
  },
  "steps": [
    {
      "id": "search_people",
      "type": "call_bot_method",
      "methodName": "search_people",
      "args": [
        "{{keyword}}",
        "{{maxResultsCount}}"
      ],
      "variable_name": "people",
      "timeout": 600,
      "onError": {
        "action": "mark_failed"
      }
    }
  ]
}
