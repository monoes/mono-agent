{
  "$schema": "../../schemas/automation.v1.schema.json",
  "schema": "monoagent.automation/v1",
  "id": "producthunt",
  "name": "Product Hunt",
  "version": "1.0.0",
  "description": "Read Product Hunt launch metrics and comments, and comment on launches",
  "publisher": {
    "name": "Mono Agent",
    "url": "https://github.com/monoes/mono-agent"
  },
  "license": "MIT",
  "engine": ">=0.0.0",
  "category": "social",
  "site": {
    "startUrl": "https://www.producthunt.com/",
    "domains": [
      "producthunt.com",
      "*.producthunt.com"
    ]
  },
  "login": {
    "url": "https://www.producthunt.com/login",
    "loggedIn": {
      "selector": "[aria-label='User menu']"
    },
    "sessionTtlDays": 30
  },
  "permissions": {
    "steps": [
      "call_bot_method"
    ],
    "scripts": [],
    "downloads": false
  },
  "requires": {
    "native": "producthunt"
  },
  "actions": [
    "comment_on_launch",
    "get_launch_metrics",
    "list_comments"
  ],
  "policy": {
    "tier": "social"
  }
}
