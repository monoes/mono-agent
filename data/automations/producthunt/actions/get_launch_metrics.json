{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "get_launch_metrics",
  "platform": "PRODUCTHUNT",
  "version": "1.1.0",
  "description": "Read a Product Hunt launch's upvotes (from the launch's own Upvote button — null while Product Hunt hides the count) and comment count (an explicit count label when the page shows one, else the comments loaded on the page; see commentsSource)",
  "sideEffects": "read",
  "metadata": {
    "requiresAuth": false,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "launchURL",
        "type": "string",
        "description": "Product Hunt launch page URL (https://www.producthunt.com/...)"
      }
    ],
    "optional": []
  },
  "outputs": {
    "success": [
      "launchURL",
      "name",
      "upvotes",
      "upvotesHidden",
      "comments",
      "commentsSource"
    ],
    "failure": [
      "error"
    ]
  },
  "steps": [
    {
      "id": "metrics",
      "type": "call_bot_method",
      "methodName": "get_launch_metrics",
      "args": [
        "{{launchURL}}"
      ],
      "variable_name": "metricsResult",
      "timeout": 45,
      "onError": {
        "action": "mark_failed"
      }
    }
  ],
  "loops": [],
  "errorHandling": {
    "globalRetries": 2,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
