{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "list_comments",
  "platform": "PRODUCTHUNT",
  "version": "1.2.0",
  "description": "List the comments loaded on a Product Hunt launch page, in page order: top-level comments (depth 0) and replies (depth 1+, with parentId)",
  "sideEffects": "read",
  "metadata": {
    "requiresAuth": false,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "launchURL",
        "type": "string",
        "description": "Product Hunt launch page URL (https://www.producthunt.com/...)"
      }
    ],
    "optional": [
      {
        "name": "maxComments",
        "type": "number",
        "description": "Stop after this many comments (0 = all loaded comments)",
        "default": 0,
        "min": 0
      }
    ]
  },
  "outputs": {
    "success": [
      "id",
      "author",
      "username",
      "text",
      "depth",
      "parentId",
      "upvotes"
    ],
    "failure": [
      "error"
    ]
  },
  "steps": [
    {
      "id": "list",
      "type": "call_bot_method",
      "methodName": "list_comments",
      "args": [
        "{{launchURL}}",
        "{{maxComments or 0}}"
      ],
      "variable_name": "commentsResult",
      "timeout": 45,
      "onError": {
        "action": "mark_failed"
      }
    }
  ],
  "loops": [],
  "errorHandling": {
    "globalRetries": 2,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
