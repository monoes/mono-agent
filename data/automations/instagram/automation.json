{
  "$schema": "../../schemas/automation.v1.schema.json",
  "schema": "monoagent.automation/v1",
  "id": "instagram",
  "name": "Instagram",
  "version": "1.0.0",
  "description": "Read Instagram profiles, posts and comments; like, comment, follow, message and publish from your own account",
  "publisher": {
    "name": "Mono Agent",
    "url": "https://github.com/monoes/mono-agent"
  },
  "license": "MIT",
  "engine": ">=0.0.0",
  "category": "social",
  "site": {
    "startUrl": "https://www.instagram.com/",
    "domains": [
      "instagram.com",
      "*.instagram.com"
    ]
  },
  "login": {
    "url": "https://www.instagram.com/accounts/login/",
    "loggedIn": {
      "selector": "svg[aria-label='New post'], a[href*='/direct/inbox/'], svg[aria-label='Home'], svg[aria-label='Direct'], svg[aria-label='Messenger']",
      "cookie": "sessionid"
    },
    "sessionTtlDays": 30
  },
  "permissions": {
    "steps": [
      "call_bot_method",
      "condition",
      "log",
      "mark_failed",
      "set_variable",
      "update_progress",
      "wait"
    ],
    "scripts": [],
    "downloads": false
  },
  "requires": {
    "native": "instagram"
  },
  "actions": [
    "auto_reply_dms",
    "comment_on_posts",
    "engage_user_posts",
    "engage_with_posts",
    "export_followers",
    "extract_post_data",
    "find_by_keyword",
    "follow_users",
    "like_comments_on_posts",
    "like_posts",
    "list_post_comments",
    "list_user_posts",
    "publish_post",
    "reply_to_comments",
    "scrape_profile_info",
    "send_dms",
    "unfollow_users",
    "watch_stories"
  ],
  "policy": {
    "tier": "social"
  }
}
