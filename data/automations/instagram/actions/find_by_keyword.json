{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "find_by_keyword",
  "platform": "INSTAGRAM",
  "version": "2.0.0",
  "description": "Search Instagram for a keyword or hashtag and collect the profiles of the posts' authors (one profile item per post author, deduplicated). The search may be kept in your Instagram search history. If Instagram asks to turn on notifications or save your login, it answers \"Not Now\", which Instagram may remember for your account.",
  "sideEffects": "read",
  "visibility": ["search_may_be_saved", "account_preference_prompt"],
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": true,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "keyword",
        "type": "string",
        "description": "Search keyword or hashtag"
      }
    ],
    "optional": [
      {
        "name": "maxResultsCount",
        "type": "number",
        "default": 20,
        "description": "Maximum number of results to collect"
      },
      {
        "name": "mediaType",
        "type": "string",
        "default": "all",
        "enum": [
          "all",
          "image",
          "video",
          "reels"
        ],
        "description": "Filter by media type"
      },
      {
        "name": "minLikes",
        "type": "number",
        "default": 0,
        "min": 0,
        "description": "Minimum likes filter"
      },
      {
        "name": "sortBy",
        "type": "string",
        "default": "recent",
        "enum": [
          "recent",
          "top"
        ],
        "description": "Sort order for results"
      },
      {
        "name": "followFound",
        "type": "boolean",
        "default": false,
        "description": "Follow discovered accounts"
      },
      {
        "name": "saveToListId",
        "type": "string",
        "default": "",
        "description": "Save results to list ID"
      }
    ]
  },
  "outputs": {
    "success": [
      "username",
      "url",
      "full_name",
      "introduction",
      "is_verified",
      "is_private",
      "image_url",
      "website",
      "follower_count",
      "following_count",
      "content_count",
      "category",
      "profile_error",
      "source_post",
      "keyword"
    ],
    "failure": []
  },
  "steps": [
    {
      "id": "find_authors",
      "type": "call_bot_method",
      "methodName": "find_post_authors",
      "args": [
        "{{keyword}}",
        "{{maxResultsCount or 20}}"
      ],
      "variable_name": "profiles",
      "timeout": 1800,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "store_count",
      "type": "update_progress",
      "set": {
        "resultsCount": "{{profiles.count}}"
      }
    },
    {
      "id": "log_success",
      "type": "log",
      "description": "Profiles found",
      "value": "Keyword: {{keyword}}, profiles: {{resultsCount}}"
    }
  ],
  "errorHandling": {
    "globalRetries": 0,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
