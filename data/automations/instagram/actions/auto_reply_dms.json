{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "auto_reply_dms",
  "platform": "INSTAGRAM",
  "version": "3.0.0",
  "description": "Reply to Instagram conversations: each item of selectedListItems is a conversation URL (/direct/t/<id>/) or a username (matched exactly in the inbox, else messaged directly). Each reply is verified. Without selectedListItems the action fails instead of doing nothing. If Instagram asks to turn on notifications or save your login, it answers \"Not Now\", which Instagram may remember for your account.",
  "sideEffects": "message",
  "visibility": ["account_preference_prompt"],
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": true,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "replyText",
        "type": "string",
        "description": "Auto-reply text"
      }
    ],
    "optional": [
      {
        "name": "startDate",
        "type": "string",
        "description": "Start date for auto-replies (YYYY-MM-DD); informational, not read by the steps"
      },
      {
        "name": "endDate",
        "type": "string",
        "description": "End date for auto-replies (YYYY-MM-DD); informational, not read by the steps"
      },
      {
        "name": "pollInterval",
        "type": "number",
        "description": "Seconds between polling for new messages; informational, not read by the steps"
      },
      {
        "name": "filterByKeyword",
        "type": "string",
        "default": "",
        "description": "Only reply to messages containing this keyword"
      },
      {
        "name": "maxRepliesPerDay",
        "type": "number",
        "default": 100,
        "min": 1,
        "max": 500,
        "description": "Max auto-replies per day"
      },
      {
        "name": "delayBeforeReply",
        "type": "number",
        "default": 5,
        "min": 1,
        "max": 60,
        "description": "Seconds to wait before sending reply"
      },
      {
        "name": "stopAfterReplies",
        "type": "number",
        "default": 0,
        "min": 0,
        "description": "Stop after N total replies (0=unlimited)"
      }
    ]
  },
  "outputs": {
    "success": [
      "success",
      "url",
      "status",
      "username"
    ],
    "failure": [
      "failedItems"
    ]
  },
  "steps": [
    {
      "id": "require_items",
      "type": "condition",
      "condition": {
        "variable": "selectedListItems",
        "operator": "not_exists"
      },
      "then": [
        "fail_no_items"
      ]
    },
    {
      "id": "fail_no_items",
      "type": "mark_failed",
      "description": "auto_reply_dms needs selectedListItems: conversation URLs or usernames to reply to"
    },
    {
      "id": "reset_replyResult",
      "type": "set_variable",
      "variable_name": "replyResult",
      "value": null
    },
    {
      "id": "wait_before_reply",
      "type": "wait",
      "duration": "{{delayBeforeReply or 5}}",
      "waitFor": "time"
    },
    {
      "id": "reply",
      "sideEffect": true,
      "type": "call_bot_method",
      "methodName": "reply_to_conversation",
      "args": [
        "{{item.url or item.href or item.username or item}}",
        "{{replyText}}"
      ],
      "variable_name": "replyResult",
      "timeout": 120,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "check_replied",
      "type": "condition",
      "condition": {
        "variable": "replyResult",
        "operator": "exists"
      },
      "then": [
        "log_success"
      ]
    },
    {
      "id": "log_success",
      "type": "log",
      "description": "Reply sent",
      "value": "Conversation: {{replyResult.url}}"
    }
  ],
  "loops": [
    {
      "id": "process_conversations",
      "iterator": "selectedListItems",
      "indexVar": "reachedIndex",
      "maxItemsPerDay": "{{maxRepliesPerDay or 100}}",
      "steps": [
        "reset_replyResult",
        "wait_before_reply",
        "reply",
        "check_replied"
      ],
      "onComplete": "update_action_state"
    }
  ],
  "errorHandling": {
    "globalRetries": 0,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
