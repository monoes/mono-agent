{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "unfollow_users",
  "platform": "INSTAGRAM",
  "version": "2.0.0",
  "description": "Unfollow Instagram users (or withdraw pending requests) from a list of profile URLs: header Following → the dialog's Unfollow, verified by the header showing Follow again. Profiles not followed are left alone. If Instagram asks to turn on notifications or save your login, it answers \"Not Now\", which Instagram may remember for your account.",
  "sideEffects": "destructive",
  "visibility": ["account_preference_prompt"],
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "selectedListItems",
        "type": "list",
        "description": "Profile URLs to unfollow"
      }
    ],
    "optional": [
      {
        "name": "maxUnfollowsPerSession",
        "type": "number",
        "default": 50,
        "min": 1,
        "max": 200,
        "description": "Rate limit: max unfollows per session"
      },
      {
        "name": "maxUnfollowsPerDay",
        "type": "number",
        "default": 150,
        "min": 1,
        "max": 500,
        "description": "Rate limit: max unfollows per day"
      },
      {
        "name": "delayBetweenUnfollows",
        "type": "number",
        "default": 5,
        "min": 2,
        "max": 60,
        "description": "Seconds to wait between unfollows"
      },
      {
        "name": "skipMutualFollows",
        "type": "boolean",
        "default": true,
        "description": "Skip accounts that follow you back"
      },
      {
        "name": "onlyNonFollowers",
        "type": "boolean",
        "default": false,
        "description": "Only unfollow accounts that don't follow you back"
      }
    ]
  },
  "outputs": {
    "success": [
      "success",
      "url",
      "username",
      "status"
    ],
    "failure": [
      "failedItems"
    ]
  },
  "steps": [
    {
      "id": "reset_unfollowResult",
      "type": "set_variable",
      "variable_name": "unfollowResult",
      "value": null
    },
    {
      "id": "unfollow_user",
      "sideEffect": true,
      "type": "call_bot_method",
      "methodName": "unfollow_user",
      "args": [
        "{{item.url or item.href or item.username or item}}"
      ],
      "variable_name": "unfollowResult",
      "timeout": 90,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "check_unfollowed",
      "type": "condition",
      "condition": {
        "variable": "unfollowResult",
        "operator": "exists"
      },
      "then": [
        "log_success"
      ]
    },
    {
      "id": "log_success",
      "type": "log",
      "description": "User unfollowed",
      "value": "Profile: {{item.url}} ({{unfollowResult.status}})"
    },
    {
      "id": "wait_between_unfollows",
      "type": "wait",
      "duration": "{{delayBetweenUnfollows or 5}}",
      "waitFor": "time"
    }
  ],
  "loops": [
    {
      "id": "process_profiles",
      "iterator": "selectedListItems",
      "indexVar": "reachedIndex",
      "maxItems": "{{maxUnfollowsPerSession or 50}}",
      "maxItemsPerDay": "{{maxUnfollowsPerDay or 150}}",
      "steps": [
        "reset_unfollowResult",
        "unfollow_user",
        "check_unfollowed",
        "wait_between_unfollows"
      ],
      "onComplete": "update_action_state"
    }
  ],
  "errorHandling": {
    "globalRetries": 0,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
