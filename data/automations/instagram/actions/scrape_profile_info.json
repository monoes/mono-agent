{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "scrape_profile_info",
  "platform": "INSTAGRAM",
  "version": "2.0.0",
  "description": "Read public profile data (name, bio, counts, website, verified/private) for a list of profiles: Instagram's own profile endpoint from inside your session, else the rendered profile page.",
  "sideEffects": "read",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "selectedListItems",
        "type": "list",
        "description": "Profile URLs to scrape"
      }
    ],
    "optional": [
      {
        "name": "saveToListId",
        "type": "string",
        "default": "",
        "description": "Save scraped profiles to list ID"
      },
      {
        "name": "updateExisting",
        "type": "boolean",
        "default": true,
        "description": "Update existing records"
      }
    ]
  },
  "outputs": {
    "success": [
      "profilesCount",
      "reachedIndex"
    ],
    "failure": [
      "failedProfileSearches"
    ]
  },
  "steps": [
    {
      "id": "reset_profileData",
      "type": "set_variable",
      "variable_name": "profileData",
      "value": null
    },
    {
      "id": "get_user_info",
      "type": "call_bot_method",
      "methodName": "get_user_info",
      "args": [
        "{{item.url or item.href or item.username or item}}"
      ],
      "variable_name": "profileData",
      "timeout": 90,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "check_profile",
      "type": "condition",
      "condition": {
        "variable": "profileData",
        "operator": "exists"
      },
      "then": [
        "log_success"
      ]
    },
    {
      "id": "log_success",
      "type": "log",
      "description": "Profile read",
      "value": "Profile: {{profileData.username}}"
    },
    {
      "id": "wait_between_profiles",
      "type": "wait",
      "duration": "{{delayBetweenProfiles or 3}}",
      "waitFor": "time"
    }
  ],
  "loops": [
    {
      "id": "process_profiles",
      "iterator": "selectedListItems",
      "indexVar": "reachedIndex",
      "steps": [
        "reset_profileData",
        "get_user_info",
        "check_profile",
        "wait_between_profiles"
      ],
      "onComplete": "update_action_state"
    }
  ],
  "errorHandling": {
    "globalRetries": 0,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
