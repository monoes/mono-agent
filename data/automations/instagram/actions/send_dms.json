{
  "actionType": "send_dms",
  "platform": "INSTAGRAM",
  "version": "2.0.0",
  "description": "Send a direct message to each recipient (profile URL or username): the profile's Message button, else the New message dialog selecting only the exact username. Each send is verified (composer cleared or the message rendered); a failure after typing is never retried another way (no double send).",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "selectedListItems",
        "type": "list",
        "description": "Profile URLs to message"
      },
      {
        "name": "messageText",
        "type": "string",
        "description": "Message text to send"
      }
    ],
    "optional": [
      {
        "name": "maxMessagesPerSession",
        "type": "number",
        "default": 30,
        "min": 1,
        "max": 100,
        "description": "Rate limit: max DMs per session"
      },
      {
        "name": "delayBetweenMessages",
        "type": "number",
        "default": 15,
        "min": 5,
        "max": 120,
        "description": "Seconds to wait between messages"
      }
    ]
  },
  "outputs": {
    "success": [
      "recipientsCount",
      "reachedIndex"
    ],
    "failure": [
      "failedMessages"
    ]
  },
  "steps": [
    {
      "id": "reset_dmResult",
      "type": "set_variable",
      "variable_name": "dmResult",
      "value": null
    },
    {
      "id": "send_dm",
      "type": "call_bot_method",
      "methodName": "send_message",
      "args": [
        "{{item.url or item.href or item.username or item}}",
        "{{messageText}}"
      ],
      "variable_name": "dmResult",
      "timeout": 120,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "check_sent",
      "type": "condition",
      "condition": {
        "variable": "dmResult",
        "operator": "exists"
      },
      "then": [
        "log_success"
      ]
    },
    {
      "id": "log_success",
      "type": "log",
      "description": "Message sent",
      "value": "Recipient: {{dmResult.username}} (via {{dmResult.method}})"
    },
    {
      "id": "wait_between_messages",
      "type": "wait",
      "duration": "{{delayBetweenMessages or 15}}",
      "waitFor": "time"
    }
  ],
  "loops": [
    {
      "id": "process_recipients",
      "iterator": "selectedListItems",
      "indexVar": "reachedIndex",
      "maxItems": "{{maxMessagesPerSession or 30}}",
      "steps": [
        "reset_dmResult",
        "send_dm",
        "check_sent",
        "wait_between_messages"
      ],
      "onComplete": "update_action_state"
    }
  ],
  "errorHandling": {
    "globalRetries": 0,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
