{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "list_post_comments",
  "platform": "INSTAGRAM",
  "version": "2.0.0",
  "description": "List comments on Instagram posts (author, text, timestamp, liked, likes, replies), loading more comments as needed.",
  "sideEffects": "read",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "selectedListItems",
        "type": "list",
        "description": "Post URLs to list comments from"
      }
    ],
    "optional": [
      {
        "name": "maxComments",
        "type": "number",
        "default": 50,
        "min": 1,
        "max": 500,
        "description": "Maximum number of comments to return per post"
      },
      {
        "name": "delayBetweenPosts",
        "type": "number",
        "default": 3,
        "min": 1,
        "max": 60,
        "description": "Seconds to wait between posts"
      }
    ]
  },
  "outputs": {
    "success": [
      "comments",
      "commentsCount",
      "reachedIndex"
    ],
    "failure": [
      "failedItems"
    ]
  },
  "steps": [
    {
      "id": "reset_comments",
      "type": "set_variable",
      "variable_name": "comments",
      "value": null
    },
    {
      "id": "list_comments",
      "type": "call_bot_method",
      "methodName": "list_post_comments",
      "args": [
        "{{item.url or item.href or item}}",
        "{{maxComments or 50}}"
      ],
      "variable_name": "comments",
      "timeout": 180,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "check_listed",
      "type": "condition",
      "condition": {
        "variable": "comments",
        "operator": "exists"
      },
      "then": [
        "log_success"
      ]
    },
    {
      "id": "log_success",
      "type": "log",
      "description": "Comments listed",
      "value": "Post: {{item.url}}"
    },
    {
      "id": "wait_between_posts",
      "type": "wait",
      "duration": "{{delayBetweenPosts or 3}}",
      "waitFor": "time"
    }
  ],
  "loops": [
    {
      "id": "process_posts",
      "iterator": "selectedListItems",
      "indexVar": "reachedIndex",
      "steps": [
        "reset_comments",
        "list_comments",
        "check_listed",
        "wait_between_posts"
      ],
      "onComplete": "update_action_state"
    }
  ],
  "errorHandling": {
    "globalRetries": 0,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
