{
  "$schema": "../../schemas/automation.v1.schema.json",
  "schema": "monoagent.automation/v1",
  "id": "x",
  "name": "X",
  "version": "1.0.0",
  "description": "Read X (Twitter) profiles, posts and followers; like, reply, message and post from your own account",
  "publisher": {
    "name": "Mono Agent",
    "url": "https://github.com/monoes/mono-agent"
  },
  "license": "MIT",
  "engine": ">=0.0.0",
  "category": "social",
  "site": {
    "startUrl": "https://x.com/",
    "domains": [
      "x.com",
      "*.x.com",
      "twitter.com",
      "*.twitter.com"
    ]
  },
  "login": {
    "url": "https://x.com/i/flow/login",
    "loggedIn": {
      "selector": "[data-testid='SideNav_AccountSwitcher_Button'], [data-testid='SideNav_NewTweet_Button'], [data-testid='AppTabBar_Profile_Link']",
      "cookie": "auth_token"
    },
    "sessionTtlDays": 30
  },
  "permissions": {
    "steps": [
      "call_bot_method",
      "condition",
      "save_data",
      "wait"
    ],
    "scripts": [],
    "downloads": false
  },
  "requires": {
    "native": "x"
  },
  "actions": [
    "auto_reply_dms",
    "engage_with_posts",
    "export_followers",
    "find_by_keyword",
    "publish_post",
    "scrape_profile_info",
    "send_dms"
  ],
  "policy": {
    "tier": "social"
  }
}
