{
  "$schema": "../../schemas/automation.v1.schema.json",
  "schema": "monoagent.automation/v1",
  "id": "gemini",
  "name": "Gemini",
  "version": "1.0.0",
  "description": "Send prompts to Google Gemini in the browser and read back text or generated images, in one-shot or persistent chat sessions",
  "publisher": {
    "name": "Mono Agent",
    "url": "https://github.com/monoes/mono-agent"
  },
  "license": "MIT",
  "engine": ">=0.0.0",
  "category": "ai",
  "site": {
    "startUrl": "https://gemini.google.com/app",
    "domains": [
      "gemini.google.com",
      "accounts.google.com",
      "consent.google.com"
    ]
  },
  "login": {
    "url": "https://gemini.google.com",
    "loggedIn": {
      "selector": "div.ql-editor[contenteditable='true'], rich-textarea, input-area-v2"
    },
    "sessionTtlDays": 30
  },
  "permissions": {
    "steps": [
      "call_bot_method",
      "click",
      "condition",
      "extract_text",
      "find_element",
      "navigate",
      "set_variable",
      "type",
      "wait"
    ],
    "scripts": [],
    "downloads": false
  },
  "requires": {
    "native": "gemini"
  },
  "actions": [
    "chat_session",
    "chat_session_many",
    "generate_image",
    "generate_text"
  ],
  "policy": {
    "tier": "standard"
  }
}
