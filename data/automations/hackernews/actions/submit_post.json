{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "submit_post",
  "platform": "HACKERNEWS",
  "version": "1.2.0",
  "description": "Submit a story to Hacker News (a link, a text post, or a link with text) and confirm it on the user's /submitted page. A duplicate URL, a rejected form or a rate limit fails. Never retried: if the story cannot be confirmed after the form was sent, the error says so instead of submitting again",
  "sideEffects": "write",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": false,
    "supportsRetry": false
  },
  "inputs": {
    "required": [
      {
        "name": "title",
        "type": "string",
        "description": "Post title"
      }
    ],
    "optional": [
      {
        "name": "url",
        "type": "string",
        "description": "Link URL (absolute http/https)"
      },
      {
        "name": "text",
        "type": "string",
        "description": "Post text (Ask/Show HN body; with a url it becomes the first comment, as on HN)"
      }
    ]
  },
  "outputs": {
    "success": [
      "id",
      "title",
      "url",
      "link",
      "author"
    ],
    "failure": [
      "error"
    ]
  },
  "steps": [
    {
      "id": "wrap_input",
      "type": "set_variable",
      "variable_name": "subIn",
      "value": {
        "title": "{{title}}",
        "url": "{{url}}",
        "text": "{{text}}"
      }
    },
    {
      "id": "clean_input",
      "type": "transform",
      "description": "Trim title and url; url must be an absolute http(s) URL (else subIn.okUrl stays empty)",
      "input": "{{subIn}}",
      "variable_name": "sub",
      "ops": [
        {
          "op": "regex_extract",
          "field": "title",
          "pattern": "^\\s*((?s).*?)\\s*$"
        },
        {
          "op": "regex_extract",
          "field": "url",
          "pattern": "^\\s*((?s).*?)\\s*$"
        },
        {
          "op": "regex_extract",
          "field": "url",
          "to": "okUrl",
          "pattern": "^(https?://[^\\s/?#]+[^\\s]*)$"
        },
        {
          "op": "regex_extract",
          "field": "text",
          "to": "hasText",
          "pattern": "(\\S)"
        }
      ]
    },
    {
      "id": "gate_url",
      "type": "condition",
      "condition": "sub.url != '' and sub.okUrl == ''",
      "then": [
        "fail_bad_url"
      ],
      "else": [
        "open_form",
        "state_form",
        "gate_user"
      ]
    },
    {
      "id": "fail_bad_url",
      "type": "mark_failed",
      "text": "hackernews: url must be an absolute http(s) URL, got \"{{sub.url}}\""
    },
    {
      "id": "open_form",
      "type": "navigate",
      "url": "https://news.ycombinator.com/submit",
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "state_form",
      "type": "call_fragment",
      "fragment": "read_page_state"
    },
    {
      "id": "gate_user",
      "type": "condition",
      "condition": "hnUser != ''",
      "then": [
        "keep_user",
        "open_before",
        "read_before",
        "reopen_form",
        "focus_title",
        "type_title",
        "gate_type_url",
        "gate_type_text",
        "find_submit",
        "gate_submit"
      ],
      "else": [
        "gate_login_refusal"
      ]
    },
    {
      "id": "gate_login_refusal",
      "type": "condition",
      "condition": "hnState.refusal != ''",
      "then": [
        "fail_form_refused"
      ],
      "else": [
        "fail_logged_out"
      ]
    },
    {
      "id": "fail_form_refused",
      "type": "mark_failed",
      "text": "hackernews: submit page refused: {{hnState.refusal}}"
    },
    {
      "id": "fail_logged_out",
      "type": "mark_failed",
      "text": "hackernews: not logged in (no #me on the submit page)"
    },
    {
      "id": "keep_user",
      "type": "set_variable",
      "variable_name": "subUser",
      "value": "{{hnUser}}"
    },
    {
      "id": "open_before",
      "type": "navigate",
      "description": "The user's newest story before submitting: the new story is the one listed above it afterwards",
      "url": "https://news.ycombinator.com/submitted?id={{subUser}}",
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "read_before",
      "type": "extract_attribute",
      "selector": "tr.athing",
      "attribute": "id",
      "variable_name": "beforeTop",
      "timeout": 2,
      "onError": {
        "action": "skip"
      }
    },
    {
      "id": "reopen_form",
      "type": "navigate",
      "url": "https://news.ycombinator.com/submit",
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "focus_title",
      "type": "press_key",
      "description": "Focus the field first: the type step inserts at the focused element on the extension page",
      "configKey": "submit.title",
      "key": "End",
      "timeout": 8,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "type_title",
      "type": "type",
      "configKey": "submit.title",
      "text": "{{sub.title}}",
      "timeout": 8,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "gate_type_url",
      "type": "condition",
      "condition": "sub.url != ''",
      "then": [
        "focus_url",
        "type_url"
      ]
    },
    {
      "id": "focus_url",
      "type": "press_key",
      "description": "Focus the field first: the type step inserts at the focused element on the extension page",
      "configKey": "submit.url",
      "key": "End",
      "timeout": 8,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "type_url",
      "type": "type",
      "configKey": "submit.url",
      "text": "{{sub.url}}",
      "timeout": 8,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "gate_type_text",
      "type": "condition",
      "condition": "sub.hasText != ''",
      "then": [
        "focus_text",
        "type_text"
      ]
    },
    {
      "id": "focus_text",
      "type": "press_key",
      "description": "Focus the field first: the type step inserts at the focused element on the extension page",
      "configKey": "submit.text",
      "key": "End",
      "timeout": 8,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "type_text",
      "type": "type",
      "configKey": "submit.text",
      "text": "{{text}}",
      "timeout": 8,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "find_submit",
      "type": "find_element",
      "configKey": "submit.button",
      "timeout": 8,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "gate_submit",
      "type": "condition",
      "description": "Submit only when every field was filled and the button found",
      "condition": "find_submit.success == true and focus_title.success == true and type_title.success == true and focus_url.success != false and type_url.success != false and focus_text.success != false and type_text.success != false",
      "then": [
        "submit",
        "state_after",
        "gate_refused",
        "gate_dup_url",
        "gate_rejected_form",
        "arm_read_back"
      ]
    },
    {
      "id": "submit",
      "type": "click",
      "sideEffect": true,
      "description": "Send the story. From here on the post may exist: nothing below submits again",
      "elementRef": "find_submit",
      "until": {
        "urlMatches": "^https://news\\.ycombinator\\.com/(r|newest|news|item|x)([?#]|$)"
      },
      "timeout": 30,
      "onError": {
        "action": "skip"
      }
    },
    {
      "id": "state_after",
      "type": "call_fragment",
      "fragment": "read_page_state"
    },
    {
      "id": "gate_refused",
      "type": "condition",
      "condition": "hnState.refusal != ''",
      "then": [
        "fail_refused"
      ],
      "else": [
        "check_dup"
      ]
    },
    {
      "id": "fail_refused",
      "type": "mark_failed",
      "text": "hackernews: Hacker News refused the submission: {{hnState.refusal}}"
    },
    {
      "id": "check_dup",
      "type": "wait_for",
      "description": "HN answers a duplicate URL by redirecting to the existing item",
      "until": {
        "urlMatches": "^https://news\\.ycombinator\\.com/item\\?"
      },
      "timeout": 1,
      "onError": {
        "action": "skip"
      }
    },
    {
      "id": "gate_dup_url",
      "type": "condition",
      "condition": "hnState.refusal == '' and check_dup.success == true",
      "then": [
        "read_dup",
        "fail_dup"
      ],
      "else": [
        "check_form"
      ]
    },
    {
      "id": "read_dup",
      "type": "extract_attribute",
      "selector": "tr.athing",
      "attribute": "id",
      "variable_name": "dupID",
      "timeout": 2,
      "onError": {
        "action": "skip"
      }
    },
    {
      "id": "fail_dup",
      "type": "mark_failed",
      "text": "hackernews: the URL was already submitted — Hacker News redirected to existing item {{dupID}}"
    },
    {
      "id": "check_form",
      "type": "wait_for",
      "description": "A form still on the page after the POST means HN rejected it",
      "until": {
        "selector": "form input[name='title']"
      },
      "timeout": 1,
      "onError": {
        "action": "skip"
      }
    },
    {
      "id": "gate_rejected_form",
      "type": "condition",
      "condition": "hnState.refusal == '' and check_dup.success != true and check_form.success == true",
      "then": [
        "fail_rejected"
      ]
    },
    {
      "id": "fail_rejected",
      "type": "mark_failed",
      "text": "hackernews: Hacker News rejected the submission: {{pageText}}"
    },
    {
      "id": "arm_read_back",
      "type": "condition",
      "condition": "hnState.refusal == '' and check_dup.success != true and check_form.success != true",
      "then": [
        "read_back_tries"
      ]
    },
    {
      "id": "read_back_tries",
      "type": "set_variable",
      "description": "Seconds to wait before each look at /submitted (three looks)",
      "variable_name": "readBackTries",
      "value": [
        0,
        2,
        2
      ]
    },
    {
      "id": "gate_try",
      "type": "condition",
      "condition": "subFound != true",
      "then": [
        "try_wait",
        "open_after",
        "read_top_id",
        "read_top_title",
        "read_top_link",
        "gate_new"
      ]
    },
    {
      "id": "try_wait",
      "type": "wait",
      "duration": "{{item}}"
    },
    {
      "id": "open_after",
      "type": "navigate",
      "url": "https://news.ycombinator.com/submitted?id={{subUser}}",
      "onError": {
        "action": "skip"
      }
    },
    {
      "id": "read_top_id",
      "type": "extract_attribute",
      "selector": "tr.athing",
      "attribute": "id",
      "variable_name": "topID",
      "timeout": 2,
      "onError": {
        "action": "skip"
      }
    },
    {
      "id": "read_top_title",
      "type": "extract_text",
      "selector": "tr.athing .titleline > a",
      "variable_name": "topTitle",
      "timeout": 2,
      "onError": {
        "action": "skip"
      }
    },
    {
      "id": "read_top_link",
      "type": "extract_attribute",
      "selector": "tr.athing .titleline > a",
      "attribute": "href",
      "variable_name": "topLink",
      "timeout": 2,
      "onError": {
        "action": "skip"
      }
    },
    {
      "id": "gate_new",
      "type": "condition",
      "description": "A story listed above the one that was newest before, carrying the submitted title or link",
      "condition": "topID > beforeTop",
      "then": [
        "gate_match"
      ],
      "else": [
        "gate_give_up"
      ]
    },
    {
      "id": "gate_match",
      "type": "condition",
      "condition": "topTitle == sub.title or topLink == sub.okUrl",
      "then": [
        "found",
        "result",
        "save"
      ],
      "else": [
        "gate_give_up"
      ]
    },
    {
      "id": "found",
      "type": "set_variable",
      "variable_name": "subFound",
      "value": true
    },
    {
      "id": "result",
      "type": "set_variable",
      "variable_name": "subResult",
      "value": {
        "id": "{{topID}}",
        "title": "{{topTitle}}",
        "url": "https://news.ycombinator.com/item?id={{topID}}",
        "link": "{{topLink}}",
        "author": "{{subUser}}"
      }
    },
    {
      "id": "save",
      "type": "save_data",
      "dataSource": "subResult"
    },
    {
      "id": "gate_give_up",
      "type": "condition",
      "condition": "tryIdx >= 2",
      "then": [
        "fail_unconfirmed"
      ]
    },
    {
      "id": "fail_unconfirmed",
      "type": "mark_failed",
      "text": "hackernews: submission not confirmed — no new item titled \"{{sub.title}}\" on /submitted; the form was submitted; not resubmitting to avoid a double post — check https://news.ycombinator.com/submitted?id={{subUser}}"
    }
  ],
  "loops": [
    {
      "id": "read_back",
      "iterator": "readBackTries",
      "indexVar": "tryIdx",
      "steps": [
        "gate_try"
      ]
    }
  ],
  "errorHandling": {
    "globalRetries": 0,
    "retryDelay": 0,
    "onFinalFailure": "log_and_continue"
  }
}
