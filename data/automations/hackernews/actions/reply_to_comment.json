{
  "$schema": "../../../schemas/action.v1.schema.json",
  "actionType": "reply_to_comment",
  "platform": "HACKERNEWS",
  "version": "1.2.0",
  "description": "Reply to a Hacker News item or comment. Succeeds only when the reply by the logged-in user shows on the item page afterwards; rate limits (\"posting too fast\") and logged-out sessions fail. Never retried, so a reply is never posted twice",
  "sideEffects": "message",
  "metadata": {"requiresAuth": true, "supportsPagination": false, "supportsRetry": false},
  "inputs": {
    "required": [
      {"name": "itemID", "type": "string", "description": "Numeric item or comment ID to reply to"},
      {"name": "text", "type": "string", "description": "Reply text"}
    ],
    "optional": []
  },
  "outputs": {"success": ["success", "itemID", "commentID", "url"], "failure": ["error"]},
  "steps": [
    {
      "id": "check_id",
      "type": "call_fragment",
      "fragment": "check_item_id",
      "description": "Accept only a numeric item id (hn.id); anything else fails"
    },
    {
      "id": "gate_id",
      "type": "condition",
      "condition": "hn.id != ''",
      "then": ["open_form", "state_form", "gate_user"],
      "else": ["fail_bad_id"]
    },
    {
      "id": "fail_bad_id",
      "type": "mark_failed",
      "text": "hackernews: item id must be numeric, got \"{{itemID}}\""
    },
    {
      "id": "open_form",
      "type": "navigate",
      "url": "https://news.ycombinator.com/reply?id={{hn.id}}&goto=item%3Fid%3D{{hn.id}}",
      "onError": {"action": "mark_failed"}
    },
    {"id": "state_form", "type": "call_fragment", "fragment": "read_page_state"},
    {
      "id": "gate_user",
      "type": "condition",
      "condition": "hnUser != ''",
      "then": ["gate_form_refusal"],
      "else": ["gate_login_refusal"]
    },
    {
      "id": "gate_login_refusal",
      "type": "condition",
      "condition": "hnState.refusal != ''",
      "then": ["fail_form_refused"],
      "else": ["fail_logged_out"]
    },
    {
      "id": "fail_logged_out",
      "type": "mark_failed",
      "text": "hackernews: not logged in (no #me on the reply page)"
    },
    {
      "id": "gate_form_refusal",
      "type": "condition",
      "condition": "hnState.refusal != ''",
      "then": ["fail_form_refused"],
      "else": ["keep_user", "focus_box", "type_box", "find_button", "gate_send"]
    },
    {
      "id": "fail_form_refused",
      "type": "mark_failed",
      "text": "hackernews: reply page refused: {{hnState.refusal}}"
    },
    {"id": "keep_user", "type": "set_variable", "variable_name": "repUser", "value": "{{hnUser}}"},
    {
      "id": "focus_box",
      "type": "press_key",
      "description": "Focus the reply box first: the type step inserts at the focused element on the extension page",
      "configKey": "reply.text",
      "key": "End",
      "timeout": 8,
      "onError": {"action": "mark_failed"}
    },
    {
      "id": "type_box",
      "type": "type",
      "configKey": "reply.text",
      "text": "{{text}}",
      "timeout": 8,
      "onError": {"action": "mark_failed"}
    },
    {
      "id": "find_button",
      "type": "find_element",
      "configKey": "reply.button",
      "timeout": 8,
      "onError": {"action": "mark_failed"}
    },
    {
      "id": "gate_send",
      "type": "condition",
      "description": "Send only when the text was typed and the button found",
      "condition": "focus_box.success == true and type_box.success == true and find_button.success == true",
      "then": ["send", "state_after", "gate_refused"]
    },
    {
      "id": "send",
      "type": "click",
      "sideEffect": true,
      "description": "Post the reply. Nothing below posts again",
      "elementRef": "find_button",
      "until": {"urlMatches": "^https://news\\.ycombinator\\.com/(item|comment|x)([?#]|$)"},
      "timeout": 30,
      "onError": {"action": "skip"}
    },
    {"id": "state_after", "type": "call_fragment", "fragment": "read_page_state"},
    {
      "id": "gate_refused",
      "type": "condition",
      "condition": "hnState.refusal != ''",
      "then": ["fail_refused"],
      "else": ["wrap_needle", "make_needle", "confirm_tries"]
    },
    {
      "id": "fail_refused",
      "type": "mark_failed",
      "text": "hackernews: Hacker News refused the reply: {{hnState.refusal}}"
    },
    {
      "id": "wrap_needle",
      "type": "set_variable",
      "variable_name": "repNeedleIn",
      "value": {"t": "{{text}}"}
    },
    {
      "id": "make_needle",
      "type": "transform",
      "description": "The start of the typed text, normalised the way match_rows normalises the page",
      "input": "{{repNeedleIn}}",
      "variable_name": "repNeedle",
      "ops": [
        {"op": "replace", "field": "t", "pattern": "[*\\s]+", "with": ""},
        {"op": "lower", "field": "t"},
        {"op": "regex_extract", "field": "t", "pattern": "^(?s)(.{0,80})"}
      ]
    },
    {
      "id": "confirm_tries",
      "type": "set_variable",
      "description": "Seconds to wait before each look for the posted reply (about 5s in all)",
      "variable_name": "confirmTries",
      "value": [0, 1, 1, 1, 1, 1]
    },
    {
      "id": "gate_confirm",
      "type": "condition",
      "condition": "repFound != true",
      "then": ["confirm_wait", "read_rows", "match_rows", "gate_mine"]
    },
    {"id": "confirm_wait", "type": "wait", "duration": "{{item}}"},
    {
      "id": "read_rows",
      "type": "extract_table",
      "description": "Every comment on the page HN returned after posting (not output: record false)",
      "selector": "body",
      "value": {"rows": "tr.athing.comtr", "record": false},
      "fields": {"id": "@id", "author": "a.hnuser", "body": ".commtext"},
      "variable_name": "repRows",
      "timeout": 5,
      "onError": {"action": "skip"}
    },
    {
      "id": "match_rows",
      "type": "transform",
      "description": "The reply just posted: by the logged-in user, newer than the parent, and containing the typed text once both sides drop asterisks and whitespace and are lower-cased (HN renders *x* as italics and blank lines as paragraphs)",
      "input": "{{repRows}}",
      "variable_name": "mine",
      "ops": [
        {
          "op": "filter",
          "where": {"variable": "author", "operator": "equals", "value": "{{repUser}}"}
        },
        {
          "op": "filter",
          "where": {"variable": "id", "operator": "greater_than", "value": "{{hn.id}}"}
        },
        {"op": "replace", "field": "body", "pattern": "[*\\s]+", "with": "", "to": "norm"},
        {"op": "lower", "field": "norm"},
        {
          "op": "filter",
          "where": {"variable": "norm", "operator": "contains", "value": "{{repNeedle.t}}"}
        },
        {"op": "limit", "count": 1}
      ]
    },
    {
      "id": "gate_mine",
      "type": "condition",
      "condition": "mine[0].id != ''",
      "then": ["rep_found", "rep_result", "rep_save"],
      "else": ["gate_give_up"]
    },
    {"id": "rep_found", "type": "set_variable", "variable_name": "repFound", "value": true},
    {
      "id": "rep_result",
      "type": "set_variable",
      "variable_name": "repResult",
      "value": {
        "success": true,
        "itemID": "{{hn.id}}",
        "commentID": "{{mine[0].id}}",
        "url": "https://news.ycombinator.com/item?id={{mine[0].id}}"
      }
    },
    {"id": "rep_save", "type": "save_data", "dataSource": "repResult"},
    {
      "id": "gate_give_up",
      "type": "condition",
      "condition": "confirmIdx >= 5",
      "then": ["fail_unconfirmed"]
    },
    {
      "id": "fail_unconfirmed",
      "type": "mark_failed",
      "text": "hackernews: reply not confirmed — no comment by {{repUser}} with the reply text on the page Hacker News returned after posting; not posting again"
    }
  ],
  "loops": [
    {
      "id": "confirm",
      "iterator": "confirmTries",
      "indexVar": "confirmIdx",
      "steps": ["gate_confirm"]
    }
  ],
  "errorHandling": {"globalRetries": 0, "retryDelay": 0, "onFinalFailure": "log_and_continue"}
}
