{
  "$schema": "https://raw.githubusercontent.com/monoes/mono-agent/master/data/schemas/automation.v1.schema.json",
  "schema": "monoagent.automation/v1",
  "id": "{{id}}",
  "name": "{{name}}",
  "version": "0.1.0",
  "description": "Log in through a username/password form.",
  "license": "MIT",
  "engine": ">=0.0.0",
  "category": "other",
  "site": {
    "startUrl": "{{startUrl}}",
    "domains": [
      "{{domain}}",
      "*.{{domain}}"
    ]
  },
  "login": {
    "url": "{{startUrl}}login",
    "loggedIn": {
      "selector": "[data-testid='account-menu']"
    },
    "usernameFrom": {
      "selector": "[data-testid='account-menu']",
      "attribute": "title"
    },
    "sessionTtlDays": 30
  },
  "permissions": {
    "steps": [
      "click",
      "navigate",
      "set_variable",
      "type",
      "wait_for"
    ],
    "scripts": [],
    "downloads": false
  },
  "actions": [
    "log_in"
  ],
  "defaults": {
    "humanLike": true,
    "timeoutSec": 60
  },
  "policy": {
    "tier": "standard"
  }
}
