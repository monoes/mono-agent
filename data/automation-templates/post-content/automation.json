{
  "$schema": "https://raw.githubusercontent.com/monoes/mono-agent/master/data/schemas/automation.v1.schema.json",
  "schema": "monoagent.automation/v1",
  "id": "{{id}}",
  "name": "{{name}}",
  "version": "0.1.0",
  "description": "Publish a post (title and body) through a web form.",
  "license": "MIT",
  "engine": ">=0.0.0",
  "category": "other",
  "site": {
    "startUrl": "{{startUrl}}",
    "domains": [
      "{{domain}}",
      "*.{{domain}}"
    ]
  },
  "permissions": {
    "steps": [
      "call_fragment",
      "click",
      "navigate",
      "set_variable",
      "type"
    ],
    "scripts": [],
    "downloads": false
  },
  "actions": [
    "create_post"
  ],
  "defaults": {
    "humanLike": true,
    "timeoutSec": 60
  },
  "policy": {
    "tier": "standard"
  }
}
