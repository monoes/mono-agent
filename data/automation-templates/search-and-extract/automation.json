{
  "$schema": "https://raw.githubusercontent.com/monoes/mono-agent/master/data/schemas/automation.v1.schema.json",
  "schema": "monoagent.automation/v1",
  "id": "{{id}}",
  "name": "{{name}}",
  "version": "0.1.0",
  "description": "Search a site and extract the result list.",
  "license": "MIT",
  "engine": ">=0.0.0",
  "category": "other",
  "site": {
    "startUrl": "{{startUrl}}",
    "domains": [
      "{{domain}}",
      "*.{{domain}}"
    ]
  },
  "permissions": {
    "steps": [
      "extract_table",
      "navigate",
      "press_key",
      "save_data",
      "transform",
      "type",
      "wait_for"
    ],
    "scripts": [],
    "downloads": false
  },
  "actions": [
    "search"
  ],
  "defaults": {
    "humanLike": true,
    "timeoutSec": 60
  },
  "policy": {
    "tier": "standard"
  }
}
