{
  "actionType": "list_comments",
  "platform": "HACKERNEWS",
  "version": "1.1.0",
  "description": "List the comments on a Hacker News item across all \"More\" pages, in thread order: every comment carries its depth (0 = top level) and parentId (the item ID for top-level comments); set topLevelOnly to keep top-level comments only",
  "metadata": {
    "requiresAuth": false,
    "supportsPagination": true,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      {
        "name": "itemID",
        "type": "string",
        "description": "Numeric item ID to read comments from"
      }
    ],
    "optional": [
      {
        "name": "topLevelOnly",
        "type": "boolean",
        "description": "Return only top-level (depth 0) comments",
        "default": false
      }
    ]
  },
  "outputs": {
    "success": [
      "id",
      "author",
      "text",
      "depth",
      "parentId",
      "age",
      "deleted"
    ],
    "failure": [
      "error"
    ]
  },
  "steps": [
    {
      "id": "list",
      "type": "call_bot_method",
      "methodName": "list_comments",
      "args": [
        "{{itemID}}",
        "{{topLevelOnly}}"
      ],
      "variable_name": "commentsResult",
      "timeout": 120,
      "onError": {
        "action": "mark_failed"
      }
    }
  ],
  "loops": [],
  "errorHandling": {
    "globalRetries": 2,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
