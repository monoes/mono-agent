{
  "actionType": "export_followers",
  "platform": "X",
  "version": "2.0.0",
  "description": "Export the followers, verified followers or following list of an X (Twitter) profile",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": true,
    "supportsRetry": true
  },
  "inputs": {
    "required": [],
    "optional": [
      { "name": "target_url", "type": "string", "description": "Profile URL or username whose list to export (profileUrl and targetUsername are accepted too)" },
      { "name": "sourceType", "type": "select", "default": "FOLLOWERS_FETCH", "options": ["FOLLOWERS_FETCH", "VERIFIED_FOLLOWERS_FETCH", "FOLLOWING_FETCH"], "description": "Which list to export" },
      { "name": "maxResultsCount", "type": "number", "default": 100, "min": 1, "max": 5000, "description": "Maximum users to export" }
    ]
  },
  "outputs": {
    "success": [
      "resultsCount",
      "maxResultsCount"
    ],
    "failure": []
  },
  "steps": [
    {
      "id": "list_followers",
      "type": "call_bot_method",
      "methodName": "list_followers",
      "args": [
        "{{target_url or profileUrl or targetUsername}}",
        "{{sourceType or 'FOLLOWERS_FETCH'}}",
        "{{maxResultsCount or 100}}"
      ],
      "variable_name": "users",
      "timeout": 900,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "save_results",
      "type": "save_data",
      "dataSource": "users"
    }
  ],
  "errorHandling": {
    "globalRetries": 1,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
