{
  "actionType": "send_dms",
  "platform": "X",
  "version": "2.0.0",
  "description": "Send direct messages to a list of recipients on X (Twitter) from their profile's Message button; each send is verified",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      { "name": "selectedListItems", "type": "list", "description": "Profile URLs or usernames to message" },
      { "name": "messageText", "type": "string", "description": "Message text to send" }
    ],
    "optional": [
      { "name": "maxMessagesPerSession", "type": "number", "default": 30, "min": 1, "max": 100, "description": "Rate limit: max DMs per session" },
      { "name": "delayBetweenMessages", "type": "number", "default": 15, "min": 5, "max": 120, "description": "Seconds to wait between messages" }
    ]
  },
  "outputs": {
    "success": [
      "recipientsCount",
      "reachedIndex"
    ],
    "failure": [
      "failedMessages"
    ]
  },
  "steps": [
    {
      "id": "send_dm",
      "type": "call_bot_method",
      "methodName": "send_dm",
      "args": [
        "{{item.url or item.href or item.username or item}}",
        "{{messageText}}"
      ],
      "variable_name": "dmResult",
      "timeout": 120,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "wait_between_messages",
      "type": "wait",
      "duration": "{{delayBetweenMessages or 15}}",
      "waitFor": "time"
    }
  ],
  "loops": [
    {
      "id": "process_recipients",
      "iterator": "selectedListItems",
      "indexVar": "reachedIndex",
      "maxItems": "{{maxMessagesPerSession or 30}}",
      "steps": [
        "send_dm",
        "wait_between_messages"
      ]
    }
  ],
  "errorHandling": {
    "globalRetries": 1,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
