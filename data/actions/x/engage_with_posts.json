{
  "actionType": "engage_with_posts",
  "platform": "X",
  "version": "2.0.0",
  "description": "Like and/or reply to X (Twitter) posts — given post URLs, or the results of a keyword search; each like and reply is verified and already-liked posts are left alone",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": true,
    "supportsRetry": true
  },
  "inputs": {
    "required": [],
    "optional": [
      { "name": "selectedListItems", "type": "list", "description": "Post URLs to engage with (when empty, the keyword search supplies the posts)" },
      { "name": "keyword", "type": "string", "description": "Search query whose posts to engage with (searches[0].keyword is accepted too)" },
      { "name": "commentText", "type": "string", "description": "Reply to post under each post (none when empty)" },
      { "name": "like", "type": "boolean", "default": true, "description": "Like each post" },
      { "name": "maxContentCount", "type": "number", "default": 10, "min": 1, "max": 100, "description": "Maximum posts to engage with" },
      { "name": "delayBetweenPosts", "type": "number", "default": 5, "min": 1, "max": 120, "description": "Seconds to wait between posts" }
    ]
  },
  "outputs": {
    "success": [
      "itemsCount",
      "reachedIndex"
    ],
    "failure": [
      "failedItems"
    ]
  },
  "steps": [
    {
      "id": "check_targets",
      "type": "condition",
      "condition": {
        "variable": "selectedListItems",
        "operator": "not_exists"
      },
      "then": [
        "search_posts"
      ]
    },
    {
      "id": "search_posts",
      "type": "call_bot_method",
      "methodName": "search_posts",
      "args": [
        "{{keyword or searches[0].keyword}}",
        "{{maxContentCount or 10}}"
      ],
      "variable_name": "foundPosts",
      "timeout": 300,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "check_like",
      "type": "condition",
      "condition": "like != false",
      "then": [
        "like_post"
      ]
    },
    {
      "id": "like_post",
      "type": "call_bot_method",
      "methodName": "like_post",
      "args": [
        "{{item.url or item.href or item}}"
      ],
      "variable_name": "likeResult",
      "timeout": 60,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "check_reply",
      "type": "condition",
      "condition": "commentText != ''",
      "then": [
        "reply_post"
      ]
    },
    {
      "id": "reply_post",
      "type": "call_bot_method",
      "methodName": "reply_post",
      "args": [
        "{{item.url or item.href or item}}",
        "{{commentText}}"
      ],
      "variable_name": "replyResult",
      "timeout": 90,
      "onError": {
        "action": "mark_failed"
      }
    },
    {
      "id": "wait_between_posts",
      "type": "wait",
      "duration": "{{delayBetweenPosts or 5}}",
      "waitFor": "time"
    }
  ],
  "loops": [
    {
      "id": "process_posts",
      "iterator": "selectedListItems or foundPosts",
      "indexVar": "reachedIndex",
      "maxItems": "{{maxContentCount or 10}}",
      "steps": [
        "check_like",
        "check_reply",
        "wait_between_posts"
      ]
    }
  ],
  "errorHandling": {
    "globalRetries": 1,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
