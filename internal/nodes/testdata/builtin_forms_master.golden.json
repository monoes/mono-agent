        "rows": 4
      },
      {
        "key": "maxWaitSeconds",
        "label": "Max Wait (seconds)",
        "type": "number",
        "required": false,
        "default": 60,
        "help": "Maximum time to wait for Gemini to respond."
      }
    ]
  },
