{
  "gemini.chat_session": {
    "credential_platform": "gemini",
    "fields": [
      {
        "key": "prompt",
        "label": "Prompt",
        "type": "textarea",
        "required": true,
        "placeholder": "Ask Gemini anything...",
        "examples": [
          "generate an image that: a wizard in a blue robe casting a fire spell",
          "now show the same wizard riding a red dragon"
        ],
        "help": "Sent to the session named by Session ID, so it can refer back to earlier answers (\"the same wizard, now …\"). Omit Session ID to start a new chat.",
        "rows": 4
      },
      {
        "key": "session_id",
        "label": "Session ID",
        "type": "text",
        "required": false,
        "help": "Existing chat session to continue (from a previous run's session_id output). Omit to start a new chat."
      },
      {
        "key": "mode",
        "label": "Response Mode",
        "type": "select",
        "required": false,
        "default": "text",
        "help": "image mode waits for generated images and downloads them to downloadDir.",
        "options": [
          "text",
          "image"
        ]
      },
      {
        "key": "referenceImagePath",
        "label": "Reference Image Path",
        "type": "text",
        "required": false,
        "help": "Local image to upload before the prompt is sent (e.g. for style transfer)."
      },
      {
        "key": "maxWaitSeconds",
        "label": "Max Wait (seconds)",
        "type": "number",
        "required": false,
        "default": 90,
        "help": "Maximum time to wait for each Gemini response.",
        "min": 10,
        "max": 300
      },
      {
        "key": "downloadDir",
        "label": "Download Directory",
        "type": "text",
        "required": false,
        "default": "~/.monoagent/downloads",
        "help": "Where to save generated images (image mode only)."
      }
    ]
  },
  "gemini.chat_session_many": {
    "credential_platform": "gemini",
    "fields": [
      {
        "key": "prompts",
        "label": "Prompts",
        "type": "array",
        "required": true,
        "placeholder": "generate an image that: a wizard in a blue robe casting a fire spell",
        "examples": [
          "generate an image that: a wizard in a blue robe casting a fire spell",
          "generate an image that: the same wizard riding a red dragon over a burning castle"
        ],
        "help": "One prompt per image, added in order and sent to a single chat session, so the character and style carry across every answer — write the second as a change to the first (\"the same wizard, now …\"). Short English prompts work best.",
        "item_type": "text"
      },
      {
        "key": "session_id",
        "label": "Session ID",
        "type": "text",
        "required": false,
        "help": "Existing chat session to continue (from a previous run's session_id output). Omit to start a new chat."
      },
      {
        "key": "mode",
        "label": "Response Mode",
        "type": "select",
        "required": false,
        "default": "text",
        "help": "image mode waits for generated images and downloads them to downloadDir.",
        "options": [
          "text",
          "image"
        ]
      },
      {
        "key": "maxWaitSeconds",
        "label": "Max Wait (seconds)",
        "type": "number",
        "required": false,
        "default": 90,
        "help": "Maximum time to wait for each response in the loop.",
        "min": 10,
        "max": 300
      },
      {
        "key": "downloadDir",
        "label": "Download Directory",
        "type": "text",
        "required": false,
        "default": "~/.monoagent/downloads",
        "help": "Where to save generated images (image mode only)."
      }
    ]
  },
  "gemini.generate_image": {
    "credential_platform": "gemini",
    "fields": [
      {
        "key": "prompt",
        "label": "Prompt",
        "type": "textarea",
        "required": true,
        "placeholder": "generate an image that: a wizard in a blue robe casting a fire spell",
        "examples": [
          "generate an image that: a wizard in a blue robe casting a fire spell",
          "generate an image that: a red bicycle leaning on a Paris café window at dawn"
        ],
        "help": "Describe the image in one short English sentence. Long or non-English prompts trigger a reasoning model that cannot generate images.",
        "rows": 4
      },
      {
        "key": "maxWaitSeconds",
        "label": "Max Wait (seconds)",
        "type": "number",
        "required": false,
        "default": 120,
        "help": "Maximum time to wait for image generation."
      },
      {
        "key": "downloadDir",
        "label": "Download Directory",
        "type": "text",
        "required": false,
        "default": "~/.monoagent/downloads",
        "help": "Where to save generated images."
      }
    ]
  },
  "gemini.generate_text": {
    "credential_platform": "gemini",
    "fields": [
      {
        "key": "prompt",
        "label": "Prompt",
        "type": "textarea",
        "required": true,
