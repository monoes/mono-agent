{
  "credential_platform": "mastodon",
  "fields": [
    { "key": "credential_id", "label": "Mastodon Connection", "type": "credential_picker", "required": true },
    { "key": "operation", "label": "Operation", "type": "select", "required": true, "options": ["publish_status", "get_timeline", "get_account", "favourite", "boost"], "default": "publish_status" },
    { "key": "text", "label": "Status Text", "type": "textarea", "required": false, "rows": 4, "depends_on": { "key": "operation", "values": ["publish_status"] } },
    { "key": "visibility", "label": "Visibility", "type": "select", "required": false, "options": ["public", "unlisted", "private", "direct"], "depends_on": { "key": "operation", "values": ["publish_status"] } },
    { "key": "spoiler_text", "label": "Content Warning", "type": "text", "required": false, "depends_on": { "key": "operation", "values": ["publish_status"] } },
    { "key": "media_ids", "label": "Media IDs", "type": "array", "required": false, "item_type": "text", "help": "Media attachment IDs to attach to the status.", "depends_on": { "key": "operation", "values": ["publish_status"] } },
    { "key": "limit", "label": "Limit", "type": "number", "required": false, "default": 20, "depends_on": { "key": "operation", "values": ["get_timeline"] } },
    { "key": "status_id", "label": "Status ID", "type": "text", "required": false, "help": "Target status for favourite or boost.", "depends_on": { "key": "operation", "values": ["favourite", "boost"] } },
    { "key": "instance", "label": "Instance URL", "type": "text", "required": false, "default": "https://mastodon.social", "help": "Mastodon instance to talk to." },
    { "key": "access_token", "label": "Access Token", "type": "text", "required": false, "help": "OAuth token from Mastodon settings. Resolved from the saved connection when omitted." }
  ]
}
